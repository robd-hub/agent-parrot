# Copy to .env for local runs. Names only here: real values live in Vercel > Settings > Environment Variables.

# Sign-in (each button only shows when its pair is set)
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Site
BASE_URL=                # public address, e.g. https://agentparrot.ai (optional on Vercel)
ADMIN_PASSWORD=          # protects every /admin page
SESSION_SECRET=          # signs login cookies; required in production
DATABASE_URL=            # Neon Postgres, set by Vercel's Neon integration; blank locally
CONTACT_EMAIL=           # shown on the privacy page
GRADER_URL=              # Agent Report Card site for paid tests; defaults to https://grader.designimp.com
CARD_PAYMENT_LINK=       # Stripe Payment Link for paying a Polly Test by card; defaults to the grader's own link. Set it empty to hide card payment

# The Daily Hallucination
ANTHROPIC_API_KEY=
CRON_SECRET=             # stops anyone but Vercel triggering the daily run

# Agents from other directories (/listed). The Official MCP Registry needs nothing.
GRAPH_API_KEY=           # free key from thegraph.com/studio, switches on the ERC-8004 registry
ERC8004_CHAINS=          # optional, e.g. base,ethereum (default: ethereum,base,bsc,polygon)
GITHUB_TOKEN=            # optional: a fine-grained GitHub token with no extra permissions, for code activity (stars, last update)

# Email (sign-in links, The Squawk, admin alerts): one of Brevo or Resend
BREVO_API_KEY=
RESEND_API_KEY=
EMAIL_FROM=
ADMIN_EMAIL=

# Local only
DEV_FAKE_LOGIN=          # 1 = one-click fake sign-in on localhost
PORT=
LOCAL_DB_DIR=
